{
  "expo": {
    "name": "Digital+",
    "slug": "digital-plus-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./digital_plus_logo.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./digital_plus_logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.digitalplus.app",
      "infoPlist": {
        "UIBackgroundModes": [
          "fetch",
          "remote-notification"
        ],
        "NSFaceIDUsageDescription": "Digital+ needs FaceID to securely access your financial data.",
        "NSCameraUsageDescription": "Digital+ needs camera access to scan receipts for quick expense adding."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./digital_plus_logo.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.digitalplus.app",
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./digital_plus_logo.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "root": "./app"
        }
      ],
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./digital_plus_logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-notifications",
      "expo-video",
      "expo-sharing"
    ],
    "extra": {
      "router": {
        "root": "./app"
      },
      "eas": {
        "projectId": "902d4f30-94b7-4f0e-aff7-531cb27ae1b3"
      }
    }
  }
}